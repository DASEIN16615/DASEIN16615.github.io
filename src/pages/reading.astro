---
import Layout from '../layouts/Layout.astro';
import { readingList, readingCategories } from '../data/reading';

const statusBadgeClasses: Record<string, string> = {
  Finished: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/20',
  Reading: 'bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/20',
  Partial: 'bg-blue-500/10 text-blue-700 dark:text-blue-400 border-blue-500/20',
  Syllabus: 'bg-zinc-500/10 text-zinc-600 dark:text-zinc-400 border-zinc-500/20',
};
---

<Layout title="书单与阅读" description="Dasein 的个人书单、计算机底层经典与名校公开课通识归档">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <!-- 头部区域 -->
    <header class="mb-10 text-center md:text-left">
      <div class="inline-block px-3 py-1 mb-3 text-[10px] font-mono tracking-widest uppercase rounded-full bg-scholar-gold/10 text-scholar-gold dark:text-scholar-goldDark">
        Reading & Mental Roots
      </div>
      <h1 class="text-4xl md:text-5xl font-serif italic text-ink dark:text-ink-dark">
        书单与精神底色<span class="text-scholar-gold dark:text-scholar-goldDark">.</span>
      </h1>
      <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400 font-serif leading-relaxed max-w-2xl">
        从 49 部通读完结的经典虚构、到 800 页 CSAPP 计算机系统长征，再到跨学科通识课程。书单是构建个人内在世界观最隐秘也最坚固的基石。
      </p>

      <!-- 真实性说明提示框 -->
      <div class="mt-6 p-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 text-xs text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed">
        <span class="font-bold text-ink dark:text-ink-dark">📌 严谨与真实性说明：</span>
        虚构作品均为全本完整通读完结；计算机系统类目为当前 A/B 日双轨学习的深度攻坚主线；公开课与宏观通识板块目前主要作为<strong>知识地图拓展与大纲目录归档</strong>（部分课程仅完成了课程框架、讲义与导论章节的整理归档），旨在保留后续深入思辨的线索，不作任何“精读完成”的学术宣称。
      </div>

      <!-- 分类筛选器 -->
      <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-zinc-200/60 dark:border-zinc-800">
        {readingCategories.map((cat, idx) => (
          <button
            class={`reading-filter-btn text-xs px-3.5 py-1.5 rounded-full transition-all cursor-pointer ${
              idx === 0
                ? 'active bg-ink dark:bg-ink-dark text-paper dark:text-paper-dark'
                : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold dark:hover:text-scholar-goldDark'
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </header>

    <!-- 书目卡片列表 -->
    <div class="space-y-4" id="reading-list">
      {readingList.map((item) => (
        <article
          class="reading-card p-5 md:p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/40 backdrop-blur-sm hover:border-scholar-gold/60 dark:hover:border-scholar-goldDark/60 transition-all duration-300"
          data-category={item.category}
        >
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-lg md:text-xl font-serif font-medium text-ink dark:text-ink-dark">
                  {item.title}
                </h2>
                {item.tag && (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
                    {item.tag}
                  </span>
                )}
              </div>
              {item.originalTitle && (
                <p class="text-xs text-zinc-400 dark:text-zinc-500 font-mono italic mt-0.5">
                  {item.originalTitle}
                </p>
              )}
            </div>

            <div class="flex items-center gap-2 self-start md:self-auto mt-1 md:mt-0">
              <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded-full border ${statusBadgeClasses[item.status]}`}>
                {item.statusText}
              </span>
            </div>
          </div>

          <div class="mt-2 text-xs font-mono text-scholar-gold dark:text-scholar-goldDark">
            作者 / 讲师：{item.author}
          </div>

          {item.notes && (
            <p class="mt-3 text-xs md:text-sm text-zinc-600 dark:text-zinc-400 font-serif leading-relaxed bg-zinc-50/50 dark:bg-zinc-950/30 p-3 rounded-lg border border-zinc-100 dark:border-zinc-800/50">
              {item.notes}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>

<script>
  function setupReadingFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.reading-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.reading-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
          b.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');
        });

        btn.classList.add('active', 'bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
        btn.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');

        const cat = btn.getAttribute('data-category');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupReadingFilter();
  document.addEventListener('astro:page-load', setupReadingFilter);
</script>
