---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const minutes = Math.max(1, Math.round((post.body?.length || 0) / 600));
---
<Layout title={post.data.title} description={post.data.description}>
  <article class="prose-custom py-8">
    <header class="mb-12">
      <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.3em] text-zinc-400 dark:text-zinc-500 font-mono">
        <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        <span>·</span>
        <a href={`/categories/${encodeURIComponent(post.data.category || '随笔')}`} class="text-scholar-gold dark:text-scholar-goldDark hover:underline">
          {post.data.category || '随笔'}
        </a>
        <span>·</span>
        <span>{minutes} 分钟</span>
      </div>
      <h1 class="mt-3">{post.data.title}</h1>
      {post.data.description && (
        <p class="mt-4 italic text-zinc-500 dark:text-zinc-400">{post.data.description}</p>
      )}
    </header>
    <Content />
    {post.data.tags?.length > 0 && (
      <div class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="text-[10px] uppercase tracking-widest px-2 py-1
 bg-zinc-100/60 dark:bg-zinc-800/60 rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</Layout>