---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404">
  <section class="min-h-[70vh] flex flex-col justify-center items-center text-center px-6">
    <h1 class="text-9xl font-serif italic text-scholar-gold dark:text-scholar-goldDark">404</h1>
    <p class="mt-4 text-sm uppercase tracking-[0.4em] text-zinc-500">Not Found</p>
    <p class="mt-8 max-w-md italic text-zinc-500">
      此路不通。也许那条线索在 Archive 里。
    </p>
    <a href="/" class="mt-12 text-xs uppercase tracking-widest text-scholar-gold dark:text-scholar-goldDark hover:underline">
      ← 返回首页
    </a>
  </section>
</Layout>