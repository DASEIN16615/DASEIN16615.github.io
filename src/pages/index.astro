---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
---
<Layout title="此在">
  <section class="min-h-[80vh] flex flex-col justify-center items-center text-center px-6 relative overflow-hidden">
    <div id="halo" class="absolute w-[60vw] h-[60vw] bg-scholar-gold/10 dark:bg-scholar-goldDark/5
 rounded-full blur-[120px] -z-10"></div>

    <div class="reveal space-y-6">
      <h1 class="text-7xl md:text-8xl font-serif italic tracking-tight opacity-90 transition-all duration-1000">
        Dasein<span class="text-scholar-gold dark:text-scholar-goldDark">.</span>
      </h1>
      <p class="text-xs md:text-sm tracking-[0.5em] uppercase font-light text-zinc-400 dark:text-zinc-500">
        Being and Time in the Digital Clearing
      </p>
      <div class="pt-12">
        <div class="w-px h-20 bg-gradient-to-b from-scholar-gold dark:from-scholar-goldDark to-transparent mx-auto"></div>
        <p class="mt-3 text-[10px] tracking-[0.3em] text-zinc-400 dark:text-zinc-600">DESCEND</p>
      </div>
    </div>

    <script is:inline>
      const halo = document.getElementById('halo');
      document.addEventListener('mousemove', (e) => {
        if (!halo) return;
        halo.style.transform = `translate(${(e.clientX - window.innerWidth / 2) * 0.15}px, ${(e.clientY - window.innerHeight / 2) * 0.15}px)`;
      });
    </script>
  </section>

  <section class="max-w-2xl mx-auto px-6 py-16">
    <div class="flex items-center gap-4 mb-8">
      <h2 class="text-xs uppercase tracking-[0.4em] text-zinc-400 dark:text-zinc-500">近期</h2>
      <div class="flex-1 h-px bg-zinc-200 dark:bg-zinc-800"></div>
      <a href="/posts" class="text-[10px] uppercase tracking-widest text-scholar-gold dark:text-scholar-goldDark hover:underline">全部 →</a>
    </div>
    <ul class="space-y-6">
      {posts.map((post) => (
        <li class="group">
          <a href={`/posts/${post.id}`} class="block">
            <time class="text-[10px] uppercase tracking-widest text-zinc-400 dark:text-zinc-500 font-mono">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <h3 class="mt-1 font-serif text-xl text-ink dark:text-ink-dark
 group-hover:text-scholar-gold dark:group-hover:text-scholar-goldDark transition-colors">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 italic">{post.data.description}</p>
            )}
          </a>
        </li>
      ))}
      {posts.length === 0 && (
        <li class="text-sm text-zinc-400 italic">尚无内容，等待书写。</li>
      )}
    </ul>
  </section>
</Layout>