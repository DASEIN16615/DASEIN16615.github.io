---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';
---
<Layout title="作品集" description="Dasein 的工程实践与开源项目档案">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <!-- 头部区域 -->
    <header class="mb-12 text-center md:text-left">
      <div class="inline-block px-3 py-1 mb-3 text-[10px] font-mono tracking-widest uppercase rounded-full bg-scholar-gold/10 text-scholar-gold dark:text-scholar-goldDark">
        Portfolio & Engineering
      </div>
      <h1 class="text-4xl md:text-5xl font-serif italic text-ink dark:text-ink-dark">
        作品集<span class="text-scholar-gold dark:text-scholar-goldDark">.</span>
      </h1>
      <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-400 font-serif leading-relaxed max-w-2xl">
        聚焦于系统底层、自主智能体架构与稳健低频量化。每一项工程均源自对实际真实痛点的抽象与闭环解决。
      </p>

      <!-- 快速筛选分类 -->
      <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-zinc-200/60 dark:border-zinc-800">
        <button class="filter-btn active text-xs px-3 py-1.5 rounded-full transition-all bg-ink dark:bg-ink-dark text-paper dark:text-paper-dark" data-category="all">
          全部 ({projects.length})
        </button>
        <button class="filter-btn text-xs px-3 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Quant">
          量化与投资
        </button>
        <button class="filter-btn text-xs px-3 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Agent">
          AI-Native & 智能体
        </button>
        <button class="filter-btn text-xs px-3 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Algorithms">
          算法与底层
        </button>
      </div>
    </header>

    <!-- 项目卡片列表 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
      {projects.map((proj) => (
        <article
          class="project-card flex flex-col justify-between p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/40 backdrop-blur-sm hover:border-scholar-gold/60 dark:hover:border-scholar-goldDark/60 transition-all duration-300 group"
          data-category={proj.category}
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-widest text-scholar-gold dark:text-scholar-goldDark font-semibold">
                {proj.category}
              </span>
              <span class={`text-[10px] px-2 py-0.5 rounded-full font-mono ${
                proj.status === 'Active'
                  ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
                  : 'bg-zinc-500/10 text-zinc-500 dark:text-zinc-400'
              }`}>
                {proj.status}
              </span>
            </div>

            <h2 class="text-xl font-serif font-bold text-ink dark:text-ink-dark group-hover:text-scholar-gold dark:group-hover:text-scholar-goldDark transition-colors">
              {proj.title}
            </h2>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 font-sans mt-0.5 mb-3">
              {proj.subtitle}
            </p>

            <p class="text-xs text-zinc-600 dark:text-zinc-300 font-serif leading-relaxed line-clamp-3 mb-4">
              {proj.description}
            </p>

            <!-- 核心亮点 -->
            <ul class="space-y-1.5 mb-5 border-t border-zinc-100 dark:border-zinc-800/60 pt-3">
              {proj.highlights.map((h) => (
                <li class="text-[11px] text-zinc-500 dark:text-zinc-400 flex items-start gap-1.5">
                  <span class="text-scholar-gold dark:text-scholar-goldDark mt-0.5 font-bold">›</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            {proj.image && (
              <div class="mb-4 rounded-xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950/10 dark:bg-zinc-950/40 p-2 relative group/preview">
                <div class="flex items-center justify-between text-[10px] font-mono text-zinc-400 mb-1.5 px-1">
                  <span class="flex items-center gap-1">📱 实际邮件排版 (框内可上下滑动)</span>
                  <button
                    type="button"
                    data-lightbox={proj.image}
                    class="text-scholar-gold dark:text-scholar-goldDark hover:underline flex items-center gap-0.5 cursor-pointer"
                  >
                    🔍 全屏大图
                  </button>
                </div>
                <div
                  class="h-56 overflow-y-auto rounded-lg border border-zinc-200/60 dark:border-zinc-800 bg-zinc-900 shadow-inner relative cursor-zoom-in"
                  data-lightbox={proj.image}
                >
                  <img
                    src={proj.image}
                    alt={`${proj.title} 实际运行交付截图`}
                    class="w-full h-auto object-cover object-top"
                    loading="lazy"
                  />
                  <div class="sticky bottom-2 mx-auto w-max px-2.5 py-0.5 rounded-full text-[9px] font-mono bg-black/80 text-zinc-300 backdrop-blur-md border border-white/10 pointer-events-none shadow-md">
                    ↕ 框内滑动浏览 · 点击全屏
                  </div>
                </div>
              </div>
            )}

            <!-- 技术标签 -->
            <div class="flex flex-wrap gap-1.5 mb-4">
              {proj.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100/80 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400">
                  #{tag}
                </span>
              ))}
            </div>

            <!-- 操作链接 -->
            <div class="flex items-center justify-between pt-3 border-t border-zinc-100 dark:border-zinc-800/60">
              <div class="flex items-center gap-3">
                {proj.github && (
                  <a
                    href={proj.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs text-zinc-700 dark:text-zinc-300 hover:text-scholar-gold dark:hover:text-scholar-goldDark transition-colors font-medium font-mono"
                  >
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                    </svg>
                    Source Code →
                  </a>
                )}
                {proj.demo && (
                  <a
                    href={proj.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-scholar-gold dark:text-scholar-goldDark hover:underline font-mono"
                  >
                    Live Preview ↗
                  </a>
                )}
              </div>
              {proj.articleUrl && (
                <a
                  href={proj.articleUrl}
                  class="text-xs text-scholar-gold dark:text-scholar-goldDark hover:underline font-mono font-medium"
                >
                  深度手记 →
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script is:inline>
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
          b.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');
        });
        btn.classList.add('bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
        btn.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');

        const cat = btn.getAttribute('data-category');
        cards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
