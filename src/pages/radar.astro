---
import Layout from '../layouts/Layout.astro';
import { starredRepos } from '../data/starred';

const categoryLabels: Record<string, string> = {
  Agent: '🤖 AI Agent 与自动化',
  Quant: '📈 量化金融与投资',
  CS: '🏛️ CS 底层与数理基石',
  Tools: '🛠️ 工具与生活进阶',
};

const formatStars = (num: number) => {
  if (num >= 1000) {
    return (num / 1000).toFixed(1) + 'k';
  }
  return num.toString();
};
---
<Layout title="技术雷达" description="Dasein 在 GitHub 点赞与精选的优质开源项目雷达">
  <div class="max-w-4xl mx-auto px-6 py-8">
    <!-- 头部区域 -->
    <header class="mb-12 text-center md:text-left">
      <div class="inline-block px-3.5 py-1 mb-3 text-xs font-mono tracking-widest uppercase rounded-full bg-scholar-gold/10 text-scholar-gold dark:text-scholar-goldDark">
        Curated Stars & Radar
      </div>
      <h1 class="text-4xl md:text-5xl font-serif italic text-ink dark:text-ink-dark">
        技术雷达<span class="text-scholar-gold dark:text-scholar-goldDark">.</span>
      </h1>
      <p class="mt-3 text-sm md:text-base text-zinc-500 dark:text-zinc-400 font-serif leading-relaxed max-w-2xl">
        从个人的 GitHub Star 列表中沉淀而出的灵感雷达。拒绝信息过载与盲目堆积，每一项收录均附带独立工程视角与选品点评。
      </p>

      <!-- 分类筛选器 -->
      <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-zinc-200/60 dark:border-zinc-800">
        <button class="radar-filter-btn active text-xs md:text-sm px-4 py-1.5 rounded-full transition-all bg-ink dark:bg-ink-dark text-paper dark:text-paper-dark" data-category="all">
          全部 ({starredRepos.length})
        </button>
        <button class="radar-filter-btn text-xs md:text-sm px-4 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Agent">
          🤖 AI Agent 与自动化
        </button>
        <button class="radar-filter-btn text-xs md:text-sm px-4 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Quant">
          📈 量化金融与投资
        </button>
        <button class="radar-filter-btn text-xs md:text-sm px-4 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="CS">
          🏛️ CS 底层与数理基石
        </button>
        <button class="radar-filter-btn text-xs md:text-sm px-4 py-1.5 rounded-full transition-all bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 hover:text-scholar-gold" data-category="Tools">
          🛠️ 工具与探索
        </button>
      </div>
    </header>

    <!-- 卡片列表网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="radar-grid">
      {starredRepos.map((repo) => (
        <article
          class="radar-card flex flex-col justify-between p-6 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white/40 dark:bg-zinc-900/40 backdrop-blur-sm hover:border-scholar-gold/60 dark:hover:border-scholar-goldDark/60 transition-all duration-300 group"
          data-category={repo.category}
        >
          <div>
            <!-- 头部元信息 -->
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-scholar-gold dark:text-scholar-goldDark uppercase tracking-wider font-semibold">
                {categoryLabels[repo.category]}
              </span>
              <div class="flex items-center gap-2 text-xs font-mono text-zinc-400">
                {repo.language && (
                  <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                    {repo.language}
                  </span>
                )}
                <span class="flex items-center gap-0.5 text-amber-600/80 dark:text-amber-400/80">
                  ★ {formatStars(repo.stars)}
                </span>
              </div>
            </div>

            <!-- 项目标题 -->
            <h2 class="text-xl md:text-2xl font-mono font-bold text-ink dark:text-ink-dark group-hover:text-scholar-gold dark:group-hover:text-scholar-goldDark transition-colors">
              <a href={repo.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                {repo.fullName}
              </a>
            </h2>

            <!-- 官方描述 -->
            <p class="text-sm md:text-base text-zinc-500 dark:text-zinc-400 font-serif leading-relaxed mt-2 line-clamp-2">
              {repo.description}
            </p>

            <!-- DASEIN 选品点评 -->
            <div class="mt-4 p-3.5 rounded-xl bg-scholar-gold/5 dark:bg-scholar-goldDark/5 border border-scholar-gold/15 dark:border-scholar-goldDark/15">
              <div class="text-xs font-mono uppercase tracking-widest text-scholar-gold dark:text-scholar-goldDark font-bold mb-1 flex items-center gap-1">
                <span>✦</span>
                <span>收录视角 / Commentary</span>
              </div>
              <p class="text-xs md:text-sm font-serif text-zinc-700 dark:text-zinc-300 leading-relaxed italic">
                “{repo.commentary}”
              </p>
            </div>
          </div>

          <!-- 底部直达链接 -->
          <div class="pt-4 mt-4 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-400">Owner: @{repo.owner}</span>
            <a
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-xs md:text-sm font-mono text-zinc-700 dark:text-zinc-300 hover:text-scholar-gold dark:hover:text-scholar-goldDark transition-colors"
            >
              GitHub Repo ↗
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <script is:inline>
    const filterBtns = document.querySelectorAll('.radar-filter-btn');
    const cards = document.querySelectorAll('.radar-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
          b.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');
        });
        btn.classList.add('bg-ink', 'dark:bg-ink-dark', 'text-paper', 'dark:text-paper-dark');
        btn.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-600', 'dark:text-zinc-300');

        const cat = btn.getAttribute('data-category');
        cards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
